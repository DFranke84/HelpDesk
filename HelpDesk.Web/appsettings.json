{
  "ConnectionStrings": {
    "HelpDesk": "Server=.;Database=HelpDesk;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Books": "Server=.;Database=Books;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Smtp": {
    // Standarad or Direct (bypassing local SMTP server and sending directly to recipient's mail server)
    "Mode": "Direct",
    "From": "helpdesk@localhost",
    "AlertTo": "admin@localhost",
    "NormalTo": "admin@localhost",
    "Standard": {
      "Host": "localhost",
      "Port": "25",
      "EnableSsl": false,
      // MailKit.Security.SecureSocketOptions — valid names: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable.
      // Typical: port 465 → SslOnConnect; port 587 → StartTls or StartTlsWhenAvailable; plain 25 → None.
      "SecureSocketOption": "None",
      "Authentication": "None"
    },
    "Direct": {
      "Host": "localhost",
      "Port": "25",
      "EnableSsl": false,
      // MailKit.Security.SecureSocketOptions — valid names: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable.
      // Typical: port 465 → SslOnConnect; port 587 → StartTls or StartTlsWhenAvailable; plain 25 → None.
      "SecureSocketOption": "None",
      // Set Authentication to Basic when using User / Password; use None for unauthenticated relays.
      "Authentication": "Basic",
      "User": "",
      "Password": ""
    }
  },
  "App": {
    "BaseUrl": "https://localhost:5001",
    "PasswordResetTokenHours": "1",
    "InitialAdminLoginId": "ADMIN",
    "InitialAdminEmail": "admin@localhost",
    "InitialAdminPassword": "ChangeMe!123",
    "WindowsAutoLoginChallenge": true,
    "SuppressWindowsAutoLoginMinutes": 1
  },
  "Logging": {
    "NLog": {
      "IncludeScopes": true,
      "RemoveLoggerFactoryFilter": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" },
      { "assembly": "NLog.Database" },
      { "assembly": "NLog.MailKit" },
      { "assembly": "NLog.Web.AspNetCore" }
    ],
    "variables": {
      "globalLevel": "Info",
      "globalLevel3rdParty": "Warn",
      "alertLevel": "Fatal",
      "manualEmailLevel": "Error",
      "emailLimit": 100,
      "emailInterval": "00:05",
      "logFolder": "${basedir}/logs"
    },
    "targets": {
      "logfile": {
        "type": "AsyncWrapper",
        "overflowAction": "Block",
        "target": {
          "type": "File",
          "layout": "${longdate}|${level:uppercase=true}|${logger}|corr=${scopeproperty:item=correlationId}|login=${scopeproperty:item=loginId}|domain=${scopeproperty:item=domainLogin}|cat=${scopeproperty:item=activityCategory}|rc=${scopeproperty:item=returnCode}|${message:withexception=true}",
          "fileName": "${var:logFolder}/helpdesk.log",
          "archiveFileName": "${var:logFolder}/helpdesk-${shortdate}.log",
          "archiveEvery": "Day",
          "archiveNumbering": "Date",
          "maxArchiveFiles": 30
        }
      },
      "db": {
        "type": "AsyncWrapper",
        "overflowAction": "Block",
        "target": {
          "type": "Database",
          "dbProvider": "Microsoft.Data.SqlClient",
          "commandType": "StoredProcedure",
          "commandText": "[dbo].[NLog_AddEntry_p]",
          "connectionString": "${configsetting:item=ConnectionStrings.HelpDesk}",
          "keepConnection": true,
          "parameters": [
            { "name": "@machineName", "layout": "${machinename}" },
            { "name": "@logged", "layout": "${date:format=o}", "dbType": "DbType.DateTime" },
            { "name": "@level", "layout": "${level}" },
            { "name": "@message", "layout": "${message}" },
            { "name": "@logger", "layout": "${logger}" },
            { "name": "@exception", "layout": "${exception:tostring}", "allowDbNull": true },
            { "name": "@elapsedTime", "layout": "${scopeproperty:item=elapsedTime}", "allowDbNull": true },
            { "name": "@numIterations", "layout": "${scopeproperty:item=numIterations}", "allowDbNull": true },
            { "name": "@activityCategory", "layout": "${scopeproperty:item=activityCategory}", "allowDbNull": true },
            { "name": "@correlationId", "layout": "${scopeproperty:item=correlationId}", "allowDbNull": true },
            { "name": "@loginId", "layout": "${scopeproperty:item=loginId}", "allowDbNull": true },
            { "name": "@domainLogin", "layout": "${scopeproperty:item=domainLogin}", "allowDbNull": true },
            { "name": "@returnCode", "layout": "${scopeproperty:item=returnCode}", "allowDbNull": true }
          ]
        }
      },
      "alertMail": {
        "type": "LimitingWrapper",
        "messageLimit": "${var:emailLimit}",
        "interval": "${var:emailInterval}",
        "target": {
          "type": "MailKit",
          "smtpServer": "${configsetting:item=Smtp.Host}",
          "smtpPort": "${configsetting:item=Smtp.Port}",
          "smtpAuthentication": "${configsetting:item=Smtp.Authentication}",
          "smtpUserName": "${configsetting:item=Smtp.User}",
          "smtpPassword": "${configsetting:item=Smtp.Password}",
          "timeout": 10000,
          "enableSsl": "${configsetting:item=Smtp.EnableSsl}",
          "secureSocketOption": "${configsetting:item=Smtp.SecureSocketOption}",
          "subject": "FATAL! HelpDesk on ${machinename}",
          "to": "${configsetting:item=Smtp.AlertTo}",
          "from": "${configsetting:item=Smtp.From}",
          "body": "${longdate}|${level:uppercase=true}|corr=${scopeproperty:item=correlationId}|login=${scopeproperty:item=loginId}|cat=${scopeproperty:item=activityCategory}|${logger}|${message}${newline}${exception:tostring}",
          "priority": "High"
        }
      },
      "normalMail": {
        "type": "LimitingWrapper",
        "messageLimit": "${var:emailLimit}",
        "interval": "${var:emailInterval}",
        "target": {
          "type": "MailKit",
          "smtpServer": "${configsetting:item=Smtp.Host}",
          "smtpPort": "${configsetting:item=Smtp.Port}",
          "smtpAuthentication": "${configsetting:item=Smtp.Authentication}",
          "smtpUserName": "${configsetting:item=Smtp.User}",
          "smtpPassword": "${configsetting:item=Smtp.Password}",
          "timeout": 10000,
          "enableSsl": "${configsetting:item=Smtp.EnableSsl}",
          "secureSocketOption": "${configsetting:item=Smtp.SecureSocketOption}",
          "subject": "${scopeproperty:item=mailSubject:whenEmpty=HelpDesk error} (corr=${scopeproperty:item=correlationId})",
          "to": "${scopeproperty:item=mailTo:whenEmpty=${configsetting:item=Smtp.NormalTo}}",
          "from": "${configsetting:item=Smtp.From}",
          "body": "${scopeproperty:item=mailBody:whenEmpty=${longdate}|${level:uppercase=true}|corr=${scopeproperty:item=correlationId}|login=${scopeproperty:item=loginId}|cat=${scopeproperty:item=activityCategory}|${logger}|${message}${newline}${exception:tostring}}",
          "priority": "Normal"
        }
      }
    },
    "rules": [
      { "logger": "System.*", "finalMinLevel": "${var:globalLevel3rdParty}", "writeTo": "logfile,db" },
      { "logger": "Microsoft.*", "finalMinLevel": "${var:globalLevel3rdParty}", "writeTo": "logfile,db" },
      { "logger": "Microsoft.Hosting.Lifetime*", "finalMinLevel": "${var:globalLevel3rdParty}", "writeTo": "logfile,db" },

      { "logger": "HelpDesk.Logging.EventLogManager", "minLevel": "Trace", "writeTo": "logfile", "final": true },
      { "logger": "ManualEmail", "minLevel": "${var:manualEmailLevel}", "writeTo": "normalMail,logfile,db" },
      { "logger": "*", "minLevel": "${var:alertLevel}", "writeTo": "alertMail" },
      { "logger": "*", "minLevel": "${var:globalLevel}", "writeTo": "logfile,db" }
    ]
  },
  "AllowedHosts": "*"
}
