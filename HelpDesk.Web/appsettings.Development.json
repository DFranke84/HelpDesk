{
  "ConnectionStrings": {
    "HelpDesk": "data source=abpdev1;initial catalog=Test_Dave_HD;Integrated Security=true;TrustServerCertificate=true;",
    "Books": "data source=abpdev1;initial catalog=Test_Dave_BK;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Smtp": {
    "AlertTo": "admin@example.com",
    "NormalTo": "admin@example.com",
    // Standard or Direct (bypassing local SMTP server and sending directly to recipient's mail server)
    "Mode": "Standard",
    "Standard": {
      "Host": "smtp.example.com",
      "Port": "25",
      "EnableSsl": false,
      // MailKit.Security.SecureSocketOptions — valid names: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable.
      // Typical: port 465 → SslOnConnect; port 587 → StartTls or StartTlsWhenAvailable; plain 25 → None.
      "SecureSocketOption": "None",
      "Authentication": "None"
    }
  },
  "App": {
    "BaseUrl": "https://localhost:44343",
    "DbInit": true
  },
  "AllowedHosts": "*",
  "DetailedErrors": true,
  "NLog": {
    "variables": {
      "globalLevel": "Info",
      "globalLevel3rdParty": "Warn",
      "emailLimit": 100,
      "emailInterval": "00:02"
    }
  }
}
