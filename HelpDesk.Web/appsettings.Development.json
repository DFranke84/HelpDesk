{
  "ConnectionStrings": {
    "HelpDesk": "data source=.;initial catalog=HelpDesk;Integrated Security=true;TrustServerCertificate=true;",
    "Books": "data source=.;initial catalog=Books;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Smtp": {
    "AlertTo": "admin@localhost",
    "NormalTo": "admin@localhost",
    // Standard or Direct (bypassing local SMTP server and sending directly to recipient's mail server)
    "Mode": "Direct",
    "Standard": {
      "Host": "localhost",
      "Port": "25",
      "EnableSsl": false,
      // MailKit.Security.SecureSocketOptions — valid names: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable.
      // Typical: port 465 → SslOnConnect; port 587 → StartTls or StartTlsWhenAvailable; plain 25 → None.
      "SecureSocketOption": "None",
      "Authentication": "None"
    },
    "Direct": {
      "Host": "localhost",
      "Port": "587",
      "EnableSsl": true,
      // MailKit.Security.SecureSocketOptions — valid names: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable.
      // Typical: port 465 → SslOnConnect; port 587 → StartTls or StartTlsWhenAvailable; plain 25 → None.
      "SecureSocketOption": "StartTls",
      // Set Authentication to Basic when using User / Password; use None for unauthenticated relays.
      "Authentication": "Basic",
      "User": "",
      // Never commit real mail settings. Host, User, Password, AlertTo and NormalTo are read from User Secrets
      // (see README). Never commit the password. It is read from User Secrets (dotnet user-secrets set "Smtp:Direct:Password" "..." --project HelpDesk.Web)
      // or from the environment variable Smtp__Direct__Password.
      "Password": ""
    }
  },
  "App": {
    "BaseUrl": "https://localhost:44343",
    "DbInit": true
  },
  "AllowedHosts": "*",
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.Components.Server": "Information",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "NLog": {
    "variables": {
      "globalLevel": "Info",
      "globalLevel3rdParty": "Warn",
      "emailLimit": 100,
      "emailInterval": "00:02"
    }
  }
}
