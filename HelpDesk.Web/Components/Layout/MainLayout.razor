@inherits LayoutComponentBase

@implements IAsyncDisposable

@using System.Security.Claims

@using HelpDesk.Web.Services

@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Nav

@inject IJSRuntime JS

@inject IStatusBarService StatusBar



<div class="hd-shell">

    <header class="hd-topbar">

        <div class="hd-brand">Help Desk</div>

        <div class="hd-topbar-right">

            <AuthorizeView Context="mainAuth">

                <Authorized>

                    <span class="hd-user-name">
                        @(mainAuth.User.FindFirst(AuthClaims.WindowsName)?.Value
                          ?? mainAuth.User.FindFirst(ClaimTypes.Name)?.Value)
                    </span>

                    @if (mainAuth.User.HasClaim(AuthClaims.MustChangePassword, "true"))
                    {
                        <button type="button" class="hd-btn ghost" @onclick="LogoutAsync">Logout</button>
                    }
                    else
                    {
                        <details class="hd-details" open="@_accountMenuOpen">

                            <summary class="hd-btn ghost" @onclick="ToggleAccountMenu" @onclick:preventDefault="true">Account</summary>

                            <div class="hd-dropdown-panel">

                                <a href="/account/change-password" @onclick="GoChangePasswordAsync" @onclick:preventDefault="true">Change password</a>

                                <button type="button" class="hd-linkbtn" @onclick="LogoutAsync">Logout</button>

                            </div>

                        </details>
                    }

                </Authorized>

                <NotAuthorized>

                    <details class="hd-details" open="@_accountMenuOpen">

                        <summary class="hd-btn ghost" @onclick="ToggleAccountMenu" @onclick:preventDefault="true">Account</summary>

                        <div class="hd-dropdown-panel">

                            <a href="/login" @onclick="GoLoginAsync" @onclick:preventDefault="true">Login</a>

                        </div>

                    </details>

                </NotAuthorized>

            </AuthorizeView>

        </div>

    </header>

    <div class="hd-body">

        <aside class="hd-sidebar">

            <NavMenu />

        </aside>

        <main class="hd-main">

            <MustChangePasswordRouteGuard>
                <CatalogRouteGuard>
                    @Body
                </CatalogRouteGuard>
            </MustChangePasswordRouteGuard>

        </main>

    </div>

    <footer class="hd-footer" role="contentinfo">
        <div class="hd-footer-status">@StatusBar.Message</div>
        <div class="hd-footer-clock">@_clockText</div>
    </footer>

</div>



@code {

    private bool _accountMenuOpen;

    private DotNetObjectReference<MainLayout>? _idleRef;

    private System.Threading.Timer? _clockTimer;

    private string _clockText = "";



    protected override void OnInitialized()

    {

        _clockText = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");

        StatusBar.Changed += OnStatusBarChanged;

        Nav.LocationChanged += OnNavigationLocationChanged;

    }



    protected override async Task OnAfterRenderAsync(bool firstRender)

    {

        if (firstRender && _clockTimer is null)

        {

            _clockTimer = new System.Threading.Timer(_ =>

            {

                _ = InvokeAsync(() =>

                {

                    _clockText = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");

                    StateHasChanged();

                });

            }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        }



        if (!firstRender || _idleRef is not null)

            return;

        try

        {

            _idleRef = DotNetObjectReference.Create(this);

            var baseUri = Nav.BaseUri.TrimEnd('/');

            await JS.InvokeVoidAsync("helpdeskIdle.start", _idleRef, $"{baseUri}/api/account/logout");

        }

        catch

        {

            /* prerender */

        }

    }



    private void OnStatusBarChanged() => _ = InvokeAsync(StateHasChanged);



    private void OnNavigationLocationChanged(object? sender, LocationChangedEventArgs e)

    {

        _accountMenuOpen = false;

        StatusBar.Clear();

    }



    private void ToggleAccountMenu() => _accountMenuOpen = !_accountMenuOpen;



    [JSInvokable]

    public void OnIdleLogout() => Nav.NavigateTo(Nav.BaseUri, forceLoad: true);



    private void GoChangePasswordAsync()

    {

        _accountMenuOpen = false;

        Nav.NavigateTo("/account/change-password");

    }



    private void GoLoginAsync()

    {

        _accountMenuOpen = false;

        Nav.NavigateTo("/login");

    }



    private async Task LogoutAsync()

    {

        _accountMenuOpen = false;

        var baseUri = Nav.BaseUri.TrimEnd('/');

        await JS.InvokeVoidAsync("helpdeskAuth.postLogout", $"{baseUri}/api/account/logout");

        Nav.NavigateTo(Nav.BaseUri, forceLoad: true);

    }



    public async ValueTask DisposeAsync()

    {

        StatusBar.Changed -= OnStatusBarChanged;

        Nav.LocationChanged -= OnNavigationLocationChanged;

        _clockTimer?.Dispose();

        _clockTimer = null;

        try { await JS.InvokeVoidAsync("helpdeskIdle.stop"); } catch { }

        _idleRef?.Dispose();

    }

}


