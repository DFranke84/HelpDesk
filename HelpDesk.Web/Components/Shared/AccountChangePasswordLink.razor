@using System.Security.Claims
@using HelpDesk.Models
@using HelpDesk.Models.Data
@using HelpDesk.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthState
@inject IDbContextFactory<HelpDeskDbContext> DbFactory
@inject NavigationManager Nav

@if (_resolved && _show)
{
    <a href="/account/change-password" @onclick="GoChangePasswordAsync" @onclick:preventDefault="true">Change password</a>
}

@code {
    [Parameter] public EventCallback OnBeforeNavigate { get; set; }

    private bool _resolved;
    private bool _show = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            _resolved = true;
            _show = false;
            return;
        }

        var typeClaim = user.FindFirst(AuthClaims.UserType)?.Value;
        if (string.Equals(typeClaim, UserType.Group.ToString(), StringComparison.Ordinal))
        {
            _show = false;
            _resolved = true;
            return;
        }
        if (string.Equals(typeClaim, UserType.User.ToString(), StringComparison.Ordinal))
        {
            _show = true;
            _resolved = true;
            return;
        }

        var idStr = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(idStr, out var id))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == id).ConfigureAwait(false);
            _show = entity?.UserType == UserType.User;
        }

        _resolved = true;
    }

    private async Task GoChangePasswordAsync()
    {
        if (OnBeforeNavigate.HasDelegate)
            await OnBeforeNavigate.InvokeAsync();
        Nav.NavigateTo("/account/change-password");
    }
}
