@page "/account/reset-password"
@attribute [AllowAnonymous]
@* Form POST; disable prerender so behavior matches classic HTML before the circuit connects. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Reset password</PageTitle>

<div class="hd-auth-center">
    <div class="login-panel">
        <h2>Set new password</h2>
        <p class="muted">Choose a new password for your account. The email states how long the link remains valid.</p>

        @if (!string.IsNullOrEmpty(_errMsg))
        {
            <p class="hd-alert" role="alert">@_errMsg</p>
        }

        <form method="post" action="/api/account/reset-password-form" class="login-form" data-enhance="false" autocomplete="off">
            <input type="hidden" name="token" value="@Token" />
            <div class="form-row">
                <label for="rp-pw1">New password</label>
                <div class="hd-password-field">
                    <input id="rp-pw1" class="hd-input hd-password-field__input" name="password" type="password" required
                           autocomplete="new-password" minlength="@HelpDesk.Web.Validation.PasswordPolicy.MinLength" />
                    <button type="button" class="hd-password-field__toggle hd-password-field__toggle--css" aria-label="Show password" aria-pressed="false" tabindex="-1"></button>
                </div>
            </div>
            <div class="form-row">
                <label for="rp-pw2">Confirm</label>
                <div class="hd-password-field">
                    <input id="rp-pw2" class="hd-input hd-password-field__input" name="confirmPassword" type="password" required
                           autocomplete="new-password" minlength="@HelpDesk.Web.Validation.PasswordPolicy.MinLength" />
                    <button type="button" class="hd-password-field__toggle hd-password-field__toggle--css" aria-label="Show password" aria-pressed="false" tabindex="-1"></button>
                </div>
            </div>
            <button type="submit" class="hd-btn primary">Update password</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "resetErr")] public string? ResetErr { get; set; }

    private string? _errMsg;

    protected override void OnParametersSet()
    {
        _errMsg = ResetErr switch
        {
            "mismatch" => "Passwords must match.",
            "short" => HelpDesk.Web.Validation.PasswordPolicy.MinLengthMessage,
            "invalid" => "Could not reset password. The link may have expired.",
            "missing" => "Missing or invalid reset link. Open the link from your email again.",
            _ => null
        };
    }
}
