@page "/admin/groups"

@attribute [Authorize(Roles = "Admin")]

@implements IAsyncDisposable

@using HelpDesk.Models

@using HelpDesk.Web.Validation

@using Microsoft.AspNetCore.Components

@inject IDbContextFactory<HelpDesk.Models.Data.HelpDeskDbContext> DbFactory

@inject IMenuRefreshNotifier MenuRefresh

@inject IStatusBarService StatusBar

@inject IJSRuntime JS

@inject NavigationManager Nav

<PageTitle>Groups</PageTitle>

<div class="hd-admin-page">
    <h1>Groups</h1>
    <p class="muted">To grant applications access to groups, use <a href="/admin/application-groups">Application groups</a>.</p>
    <div class="hd-admin-toolbar">
        <button type="button" class="hd-btn primary" @onclick="OpenAdd">Add</button>
    </div>
    <table id="tbl-admin-groups" class="hd-dt cell-border compact stripe" style="width:100%"></table>
    @if (!string.IsNullOrEmpty(_msg) && !_modalOpen)
    {
        <p class="muted">@_msg</p>
    }
</div>

@if (_modalOpen)
{
    <div class="hd-modal-backdrop">
        <div class="hd-modal-scrim" @onclick="CloseModalAsync"></div>
        <div class="hd-modal" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrEmpty(_msg))
            {
                <p class="hd-modal-banner" role="alert">@_msg</p>
            }
            <h3 class="hd-modal-title">@(_editingId is null ? "Add group" : "Edit group")</h3>
            <div class="form-row"><label>Name</label><input class="hd-input" value="@_name" @oninput="OnNameInput" autocomplete="off" /></div>
            <div class="form-row"><label>Description</label><input class="hd-input" @bind="_desc" /></div>
            <div class="hd-modal-actions">
                <button type="button" class="hd-btn primary" @onclick="SaveAsync">Save</button>
                @if (_editingId is null)
                {
                    <button type="button" class="hd-btn" @onclick="ClearFormAsync">Clear</button>
                }
                <button type="button" class="hd-btn" @onclick="CloseModalAsync">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string TableId = "tbl-admin-groups";
    private const string InteropKey = "groups";

    private DotNetObjectReference<AdminGroups>? _interop;
    private int? _editingId;
    private bool _modalOpen;
    private string _name = "";
    private string? _desc;
    private string? _msg;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        if (!await JS.InvokeAsync<bool>("helpdeskAdmin.needsInit", TableId))
            return;
        _interop = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("helpdeskAdmin.register", InteropKey, _interop);
        var url = Nav.ToAbsoluteUri("/api/grid/admin/groups").ToString();
        await JS.InvokeVoidAsync("helpdeskAdmin.initGroups", TableId, url);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("helpdeskAdmin.unregister", InteropKey);
            await JS.InvokeVoidAsync("helpdeskAdmin.destroyTable", TableId);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _interop?.Dispose();
    }

    private void ResetEmpty()
    {
        _editingId = null;
        _name = "";
        _desc = "";
    }

    private void OpenAdd()
    {
        ResetEmpty();
        _modalOpen = true;
        _msg = null;
    }

    [JSInvokable]
    public async Task OpenEdit(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var g = await db.Groups.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (g is null)
        {
            _msg = "Group not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        _editingId = g.Id;
        _name = g.Name;
        _desc = g.Description;
        _modalOpen = true;
        _msg = null;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PromptDelete(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var g = await db.Groups.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (g is null)
        {
            _msg = "Not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete group \"{g.Name}\"? User assignments and application links for this group will be removed."))
            return;

        var row = await db.Groups.FirstOrDefaultAsync(x => x.Id == id);
        if (row is null)
            return;

        db.Groups.Remove(row);
        if (!await db.TrySaveChangesAsync(JS))
            return;
        if (_editingId == id)
        {
            _modalOpen = false;
            ResetEmpty();
        }
        _msg = "Deleted.";
        StatusBar.SetMessage("Deleted.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModalAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Close the editor? Unsaved changes will be lost."))
            return;
        _modalOpen = false;
        ResetEmpty();
    }

    private async Task ClearFormAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear the form? Unsaved changes will be lost."))
            return;
        if (_editingId is { } gid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var g = await db.Groups.AsNoTracking().FirstOrDefaultAsync(x => x.Id == gid);
            if (g is not null)
                await OpenEdit(g.Id);
            else
                ResetEmpty();
        }
        else
        {
            ResetEmpty();
        }
    }

    private async Task SaveAsync()
    {
        var nameNorm = AdminNameValidation.ToUpperNoSpaces(_name);
        var nameErr = AdminNameValidation.ErrorIfEmptyCatalogName(nameNorm, "Name");
        if (nameErr is not null)
        {
            _msg = nameErr;
            return;
        }

        var confirmMsg = _editingId is null ? "Create this group?" : "Save changes to this group?";
        if (!await JS.InvokeAsync<bool>("confirm", confirmMsg))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (_editingId is { } gid)
        {
            var g = await db.Groups.FirstOrDefaultAsync(x => x.Id == gid);
            if (g is null)
            {
                _msg = "Not found.";
                return;
            }

            g.Name = nameNorm;
            g.Description = _desc;
            g.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            db.Groups.Add(new DeskGroup
            {
                Name = nameNorm,
                Description = _desc,
                CreatedAt = DateTime.UtcNow
            });
        }

        if (!await db.TrySaveChangesAsync(JS))
            return;
        _modalOpen = false;
        ResetEmpty();
        _msg = "Saved.";
        StatusBar.SetMessage("Saved.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
    }

    private void OnNameInput(ChangeEventArgs e) =>
        _name = AdminNameValidation.ToUpperNoSpaces(e.Value?.ToString());
}
