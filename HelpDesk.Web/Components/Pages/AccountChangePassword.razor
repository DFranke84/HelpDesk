@page "/account/change-password"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Change password</PageTitle>

<div class="hd-auth-center">
    <div class="login-panel">
        <h2>Change password</h2>
        <p class="muted">Enter your current password, then your new password twice.</p>

        <form @onsubmit="SaveAsync" @onsubmit:preventDefault autocomplete="off">
            <div class="form-row">
                <label for="chg-current">Current password</label>
                <PasswordField Id="chg-current" Autocomplete="current-password" Autofocus="true" @bind-Value="_current" />
            </div>
            <div class="form-row">
                <label for="chg-new1">New password</label>
                <PasswordField Id="chg-new1" Autocomplete="new-password" @bind-Value="_pw1" />
            </div>
            <div class="form-row">
                <label for="chg-new2">Confirm new password</label>
                <PasswordField Id="chg-new2" Autocomplete="new-password" @bind-Value="_pw2" />
            </div>
            <div class="hd-modal-actions">
                <button type="submit" class="hd-btn primary" disabled="@_busy">Change password</button>
                <button type="button" class="hd-btn" @onclick="Cancel">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_msg))
            {
                <p class="hd-alert">@_msg</p>
            }
        </form>
    </div>
</div>

@code {
    private const string ChangePasswordPath = "/account/change-password";

    private string _current = "";
    private string _pw1 = "";
    private string _pw2 = "";
    private string? _msg;
    private bool _busy;
    private string? _pathFocusedFor;

    private void Cancel()
    {
        Nav.NavigateTo("/");
    }

    private async Task SaveAsync()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_current))
        {
            _msg = "Enter your current password.";
            return;
        }
        if (_pw1 != _pw2 || string.IsNullOrWhiteSpace(_pw1))
        {
            _msg = "New passwords must match and cannot be empty.";
            return;
        }
        if (_pw1.Length < HelpDesk.Web.Validation.PasswordPolicy.MinLength)
        {
            _msg = HelpDesk.Web.Validation.PasswordPolicy.MinLengthMessage;
            return;
        }

        _busy = true;
        try
        {
            var baseUri = Nav.BaseUri.TrimEnd('/');
            var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("helpdeskAuth.postJson",
                $"{baseUri}/api/account/set-password",
                new { currentPassword = _current, newPassword = _pw1 });

            if (!result.TryGetProperty("ok", out var fetchOk) || !fetchOk.GetBoolean())
            {
                if (result.TryGetProperty("data", out var errBody) && errBody.TryGetProperty("error", out var err))
                    _msg = err.GetString() ?? "Could not update password.";
                else
                    _msg = "Could not update password.";
                return;
            }

            Nav.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (!path.Equals(ChangePasswordPath, StringComparison.OrdinalIgnoreCase))
        {
            _pathFocusedFor = null;
            return;
        }

        if (string.Equals(_pathFocusedFor, path, StringComparison.Ordinal))
            return;

        try
        {
            await JS.InvokeVoidAsync("helpdeskUi.focusById", "chg-current");
            _pathFocusedFor = path;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }
}
