@page "/app/{AppId:int}/page/{PageId:int}"

@using System.Security.Claims

@using HelpDesk.Models
@using HelpDesk.Web.Services

@using HelpDesk.Models.Data

@inject IDbContextFactory<HelpDeskDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IMenuService MenuService
@inject IPagePermissionService PagePermissionService

<PageTitle>@(_title)</PageTitle>

@if (_navigatingAway)
{
    <p class="muted">Opening…</p>
}
else if (_loading)
{
    <p class="muted">Loading page...</p>
}
else if (_accessDenied)
{
    <h1>Access denied</h1>
    <p class="muted">You do not have permission to open this page. Use the menu to see the pages available to you.</p>
}
else if (_readPermissionRequired)
{
    <div class="alert alert-warning">
        <h4>Read Permission Required</h4>
        <p>You can see this page in the navigation, but you need explicit read permission to access its content. Please contact your administrator.</p>
    </div>
}
else if (_page is null)
{
    <p>Page not found.</p>
}
else
{
    <h1>@_page.Name</h1>

    <p class="muted">Application ID: @AppId · Route: <code>@_page.Route</code></p>

    <div class="hd-card">
        <p>This is a placeholder for help content. Replace with dynamic content or embedded tools for this page.</p>
    </div>
}

@code {
    [Parameter] public int AppId { get; set; }
    [Parameter] public int PageId { get; set; }

    private DeskPage? _page;
    private bool _navigatingAway;
    private bool _loading = true;
    private bool _accessDenied;
    private bool _readPermissionRequired;
    private string _title = "Page";
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _navigatingAway = false;
        _accessDenied = false;
        _readPermissionRequired = false;
        _isAdmin = false;
        
        await using var db = await DbFactory.CreateDbContextAsync();
        _page = await db.Pages.AsNoTracking()
            .Where(p => p.Id == PageId && p.DeskApplicationId == AppId)
            .FirstOrDefaultAsync();

        if (_page is null)
        {
            _title = "Page";
            _loading = false;
            return;
        }

        _title = _page.Name;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true
            || !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            _accessDenied = true;
            _loading = false;
            return;
        }

        _isAdmin = user.IsInRole(nameof(UserRole.Admin));
        
        // Check group access via MenuService (determines if page appears in navigation)
        var allowed = await MenuService.GetAccessiblePagesAsync(AppId, userId, _isAdmin);
        if (!allowed.Exists(p => p.Id == PageId))
        {
            _accessDenied = true;
            _loading = false;
            return;
        }

        // For admins, skip permission checks - they have full access
        if (!_isAdmin)
        {
            // Check if user has read permission for the page content
            var canRead = await PagePermissionService.CanUserPerformActionAsync(userId, PageId, CrudAction.Read);
            if (!canRead)
            {
                _readPermissionRequired = true;
                _loading = false;
                return;
            }
        }

        var route = _page.Route?.Trim();
        if (!string.IsNullOrEmpty(route)
            && route.StartsWith("/", StringComparison.Ordinal)
            && !route.StartsWith("/app/", StringComparison.OrdinalIgnoreCase))
        {
            _navigatingAway = true;
            Nav.NavigateTo(route, replace: true);
        }
        
        _loading = false;
    }
}
