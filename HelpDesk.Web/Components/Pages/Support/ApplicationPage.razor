@page "/app/{AppId:int}/page/{PageId:int}"

@using System.Security.Claims

@using HelpDesk.Models
@using HelpDesk.Web.Services

@using HelpDesk.Models.Data

@inject IDbContextFactory<HelpDeskDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IMenuService MenuService
@inject IPagePermissionService PagePermissionService

<PageTitle>@(_title)</PageTitle>

@if (_needsToOpenNewTab && !string.IsNullOrEmpty(_urlToOpen))
{
    <div class="hd-card">
        <h3>@_page.Name</h3>
        <p>This page opens in a new browser tab:</p>
        <p><a href="@_urlToOpen" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open @_urlToOpen</a></p>
    </div>
}
else if (_navigatingAway)
{
    <p class="muted">Opening…</p>
}
else if (_loading)
{
    <p class="muted">Loading page...</p>
}
else if (_accessDenied)
{
    <h1>Access denied</h1>
    <p class="muted">You do not have permission to open this page. Use the menu to see the pages available to you.</p>
}
else if (_readPermissionRequired)
{
    <div class="alert alert-warning">
        <h4>Read Permission Required</h4>
        <p>You can see this page in the navigation, but you need explicit read permission to access its content. Please contact your administrator.</p>
    </div>
}
else if (_page is null)
{
    <p>Page not found.</p>
}
else
{
    <h1>@_page.Name</h1>

    @if (!string.IsNullOrWhiteSpace(_page.Url))
    {
        <p class="muted">Application ID: @AppId · URL: <code>@_page.Url</code> @(_page.OpenInNewTab ? "(opens in new tab)" : "(embedded)")</p>
        
        @if (_page.OpenInNewTab)
        {
            <div class="hd-card">
                <p>This page should have automatically opened in a new tab and redirected you to the dashboard.</p>
                <p>If it didn't open automatically, <a href="@_page.Url" target="_blank" rel="noopener noreferrer">click here to open</a></p>
            </div>
        }
        else
        {
            <div class="hd-card" style="padding: 0; height: 80vh;">
                <iframe src="@_page.Url" 
                        style="width: 100%; height: 100%; border: none;" 
                        sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                        title="@_page.Name"
                        onload="this.style.display='block';"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                </iframe>
                <div style="display: none; padding: 20px;">
                    <div class="alert alert-warning">
                        <h4>Content could not be loaded</h4>
                        <p>The external content could not be displayed in this frame. This may be due to security restrictions.</p>
                        <a href="@_page.Url" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open in New Tab</a>
                    </div>
                </div>
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(_page.Route))
    {
        <p class="muted">Application ID: @AppId · Route: <code>@_page.Route</code></p>
        
        <div class="hd-card">
            <p>This is a placeholder for help content. Replace with dynamic content or embedded tools for this page.</p>
        </div>
    }
    else
    {
        <p class="muted">Application ID: @AppId</p>
        
        <div class="hd-card">
            <p>This is a placeholder for help content. Replace with dynamic content or embedded tools for this page.</p>
        </div>
    }
}

@code {
    [Parameter] public int AppId { get; set; }
    [Parameter] public int PageId { get; set; }

    private DeskPage? _page;
    private bool _navigatingAway;
    private bool _loading = true;
    private bool _accessDenied;
    private bool _readPermissionRequired;
    private string _title = "Page";
    private bool _isAdmin;
    private bool _needsToOpenNewTab;
    private string? _urlToOpen;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _navigatingAway = false;
        _accessDenied = false;
        _readPermissionRequired = false;
        _isAdmin = false;
        _needsToOpenNewTab = false;
        _urlToOpen = null;
        
        await using var db = await DbFactory.CreateDbContextAsync();
        _page = await db.Pages.AsNoTracking()
            .Where(p => p.Id == PageId && p.DeskApplicationId == AppId)
            .FirstOrDefaultAsync();

        if (_page is null)
        {
            _title = "Page";
            _loading = false;
            return;
        }

        _title = _page.Name;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true
            || !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            _accessDenied = true;
            _loading = false;
            return;
        }

        _isAdmin = user.IsInRole(nameof(UserRole.Admin));
        
        // Check group access via MenuService (determines if page appears in navigation)
        var allowed = await MenuService.GetAccessiblePagesAsync(AppId, userId, _isAdmin);
        if (!allowed.Exists(p => p.Id == PageId))
        {
            _accessDenied = true;
            _loading = false;
            return;
        }

        // For admins, skip permission checks - they have full access
        if (!_isAdmin)
        {
            // Check if user has read permission for the page content
            var canRead = await PagePermissionService.CanUserPerformActionAsync(userId, PageId, CrudAction.Read);
            if (!canRead)
            {
                _readPermissionRequired = true;
                _loading = false;
                return;
            }
        }

        // Handle URL navigation if it should open in new tab
        var url = _page.Url?.Trim();
        if (!string.IsNullOrEmpty(url) && _page.OpenInNewTab)
        {
            _needsToOpenNewTab = true;
            _urlToOpen = url;
            _loading = false;
            return;
        }
        
        // Handle internal route navigation (existing behavior)
        var route = _page.Route?.Trim();
        if (!string.IsNullOrEmpty(route)
            && route.StartsWith("/", StringComparison.Ordinal)
            && !route.StartsWith("/app/", StringComparison.OrdinalIgnoreCase))
        {
            _navigatingAway = true;
            Nav.NavigateTo(route, replace: true);
        }
        
        _loading = false;
    }

}
