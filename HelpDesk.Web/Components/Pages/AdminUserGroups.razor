@page "/admin/user-groups"

@attribute [Authorize(Roles = "Admin")]

@implements IAsyncDisposable

@using HelpDesk.Models

@inject IDbContextFactory<HelpDesk.Models.Data.HelpDeskDbContext> DbFactory

@inject IMenuRefreshNotifier MenuRefresh

@inject IStatusBarService StatusBar

@inject IJSRuntime JS

@inject NavigationManager Nav

<PageTitle>User groups</PageTitle>

<div class="hd-admin-page">
    <h1>User groups</h1>
    <div class="hd-admin-toolbar">
        <button type="button" class="hd-btn primary" @onclick="OpenAddAsync" disabled="@(_users.Count == 0 || _groupOptions.Count == 0)">Add</button>
    </div>
    @if (_users.Count == 0 || _groupOptions.Count == 0)
    {
        <div class="hd-card" style="margin-top:0.75rem;">
            <strong>Setup required.</strong>
            <div class="muted">Add at least one user and one group first.</div>
        </div>
    }
    else
    {
        <table id="tbl-admin-user-groups" class="hd-dt cell-border compact stripe" style="width:100%"></table>
    }
    @if (!string.IsNullOrEmpty(_msg) && !_modalOpen)
    {
        <p class="muted">@_msg</p>
    }
</div>

@if (_modalOpen)
{
    <div class="hd-modal-backdrop">
        <div class="hd-modal-scrim" @onclick="CloseModalAsync"></div>
        <div class="hd-modal" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrEmpty(_msg))
            {
                <p class="hd-modal-banner" role="alert">@_msg</p>
            }
            <h3 class="hd-modal-title">@(_editing ? "Edit assignment" : "Assign user to group")</h3>
            <div class="form-row">
                <label>User</label>
                <select class="hd-input" @bind="_userId">
                    @foreach (var u in _users)
                    {
                        <option value="@u.Id">@u.LoginId</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label>Group</label>
                <select class="hd-input" @bind="_groupId">
                    @foreach (var g in _groupOptions)
                    {
                        <option value="@g.Id">@g.Label</option>
                    }
                </select>
            </div>
            <div class="hd-modal-actions">
                <button type="button" class="hd-btn primary" @onclick="SaveAsync">@(_editing ? "Save" : "Assign")</button>
                @if (!_editing)
                {
                    <button type="button" class="hd-btn" @onclick="ClearFormAsync">Clear</button>
                }
                <button type="button" class="hd-btn" @onclick="CloseModalAsync">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string TableId = "tbl-admin-user-groups";
    private const string InteropKey = "userGroups";

    private sealed class GroupOption
    {
        public int Id { get; init; }
        public string Label { get; init; } = "";
    }

    private DotNetObjectReference<AdminUserGroups>? _interop;
    private List<User> _users = new();
    private List<GroupOption> _groupOptions = new();
    private int _userId;
    private int _groupId;
    private int? _origUserId;
    private int? _origGroupId;
    private bool _editing;
    private bool _modalOpen;
    private string? _msg;

    protected override async Task OnInitializedAsync() => await ReloadLookupsAsync();

    private async Task ReloadLookupsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync().ConfigureAwait(false);
        _users = await db.Users.AsNoTracking().OrderBy(u => u.LoginId).ToListAsync().ConfigureAwait(false);
        var groups = await db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync().ConfigureAwait(false);
        _groupOptions = groups.Select(g => new GroupOption { Id = g.Id, Label = g.Name }).ToList();
        if (_users.Count > 0)
            _userId = _users[0].Id;
        if (_groupOptions.Count > 0)
            _groupId = _groupOptions[0].Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_users.Count == 0 || _groupOptions.Count == 0)
            return;
        if (!await JS.InvokeAsync<bool>("helpdeskAdmin.needsInit", TableId).ConfigureAwait(false))
            return;
        if (_interop is null)
        {
            _interop = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("helpdeskAdmin.register", InteropKey, _interop).ConfigureAwait(false);
        }
        var url = Nav.ToAbsoluteUri("/api/grid/admin/user-groups").ToString();
        await JS.InvokeVoidAsync("helpdeskAdmin.initUserGroups", TableId, url).ConfigureAwait(false);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("helpdeskAdmin.unregister", InteropKey).ConfigureAwait(false);
            await JS.InvokeVoidAsync("helpdeskAdmin.destroyTable", TableId).ConfigureAwait(false);
        }
        catch { /* */ }
        _interop?.Dispose();
    }

    private void ResetForAdd()
    {
        _editing = false;
        _origUserId = null;
        _origGroupId = null;
        if (_users.Count > 0)
            _userId = _users[0].Id;
        if (_groupOptions.Count > 0)
            _groupId = _groupOptions[0].Id;
    }

    private async Task OpenAddAsync()
    {
        if (_users.Count == 0 || _groupOptions.Count == 0)
        {
            _msg = "Add at least one user and one group first.";
            return;
        }
        ResetForAdd();
        _modalOpen = true;
        _msg = null;
        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OpenEdit(int userId, int groupId)
    {
        _editing = true;
        _origUserId = userId;
        _origGroupId = groupId;
        _userId = userId;
        _groupId = groupId;
        _modalOpen = true;
        _msg = null;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PromptDelete(int userId, int groupId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Remove this user–group assignment?").ConfigureAwait(false))
            return;
        await using var db = await DbFactory.CreateDbContextAsync().ConfigureAwait(false);
        var row = await db.UserGroups.FirstOrDefaultAsync(x => x.UserId == userId && x.GroupId == groupId).ConfigureAwait(false);
        if (row is null)
            return;
        db.UserGroups.Remove(row);
        if (!await db.TrySaveChangesAsync(JS).ConfigureAwait(false))
            return;
        if (_editing && _origUserId == userId && _origGroupId == groupId)
        {
            _modalOpen = false;
            ResetForAdd();
        }
        _msg = "Deleted.";
        StatusBar.SetMessage("Deleted.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId).ConfigureAwait(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModalAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Close the editor? Unsaved changes will be lost.").ConfigureAwait(false))
            return;
        _modalOpen = false;
        ResetForAdd();
    }

    private async Task ClearFormAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear the form? Unsaved changes will be lost.").ConfigureAwait(false))
            return;
        if (_editing && _origUserId is { } ou && _origGroupId is { } og)
            await OpenEdit(ou, og);
        else
            ResetForAdd();
    }

    private async Task SaveAsync()
    {
        _msg = null;
        if (_users.Count == 0 || _groupOptions.Count == 0)
        {
            _msg = "Add at least one user and one group first.";
            return;
        }

        var confirmMsg = _editing ? "Save changes to this assignment?" : "Create this assignment?";
        if (!await JS.InvokeAsync<bool>("confirm", confirmMsg).ConfigureAwait(false))
            return;

        await using var db = await DbFactory.CreateDbContextAsync().ConfigureAwait(false);

        if (_editing && _origUserId is { } ou && _origGroupId is { } og)
        {
            if (ou == _userId && og == _groupId)
            {
                _msg = "No changes.";
                return;
            }

            if (await db.UserGroups.AnyAsync(x => x.UserId == _userId && x.GroupId == _groupId).ConfigureAwait(false))
            {
                _msg = "That assignment already exists.";
                return;
            }

            var old = await db.UserGroups.FirstOrDefaultAsync(x => x.UserId == ou && x.GroupId == og).ConfigureAwait(false);
            if (old is null) { _msg = "Original row missing."; return; }

            db.UserGroups.Remove(old);
            db.UserGroups.Add(new UserGroup { UserId = _userId, GroupId = _groupId, AssignedAt = DateTime.UtcNow });
        }
        else
        {
            if (await db.UserGroups.AnyAsync(x => x.UserId == _userId && x.GroupId == _groupId).ConfigureAwait(false))
            {
                _msg = "Already assigned.";
                return;
            }

            db.UserGroups.Add(new UserGroup { UserId = _userId, GroupId = _groupId, AssignedAt = DateTime.UtcNow });
        }

        var wasEditing = _editing;
        if (!await db.TrySaveChangesAsync(JS).ConfigureAwait(false))
            return;
        _modalOpen = false;
        ResetForAdd();
        await ReloadLookupsAsync().ConfigureAwait(false);
        _msg = wasEditing ? "Updated." : "Assigned.";
        StatusBar.SetMessage(wasEditing ? "Updated." : "Assigned.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId).ConfigureAwait(false);
    }
}
