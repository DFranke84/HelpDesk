@page "/admin/applications"

@attribute [Authorize(Roles = "Admin")]

@implements IAsyncDisposable

@using HelpDesk.Models

@using HelpDesk.Web.Validation

@using Microsoft.AspNetCore.Components

@using Microsoft.JSInterop

@inject IDbContextFactory<HelpDesk.Models.Data.HelpDeskDbContext> DbFactory

@inject IMenuRefreshNotifier MenuRefresh

@inject IStatusBarService StatusBar

@inject IJSRuntime JS

@inject NavigationManager Nav

<PageTitle>Applications</PageTitle>

<div class="hd-admin-page">
    <h1>Applications</h1>
    <div class="hd-admin-toolbar hd-apps-toolbar">
        <button type="button" class="hd-btn primary" @onclick="OpenAdd">Add</button>
    </div>

    <div class="hd-apps-examples">
        <p class="muted" style="margin: 0 0 0.75rem 0;">
            External connection names reference keys in configuration (for example <code>appsettings.json</code> under <code>ConnectionStrings</code>) — not secrets stored in the database.
        </p>
        <div class="hd-card" style="margin-top: 0;">
            <h3 style="margin-top: 0;">Examples</h3>
            <ul class="muted" style="margin: 0.5rem 0 0 0; padding-left: 1.25rem;">
                <li style="margin-bottom: 0.5rem;">
                    <strong>External connection name</strong> (value stored on the application row):
                    <code>ContosoOrdersDb</code>
                    — in <code>appsettings.json</code> add a matching connection string entry (same logical name you use in configuration; often under <code>ConnectionStrings</code>).
                </li>
                <li>
                    <strong>External DB key</strong> (the configuration path used to resolve the connection string):
                    typically <code>ConnectionStrings:ContosoOrdersDb</code> or, in environment variables, <code>ConnectionStrings__ContosoOrdersDb</code>.
                    The app reads <code>ExternalConnectionStringName</code> (e.g. <code>ContosoOrdersDb</code>) and looks up that name in configuration — the key is that logical name, not the connection secret.
                </li>
            </ul>
        </div>
    </div>

    <table id="tbl-admin-applications" class="hd-dt cell-border compact stripe" style="width:100%"></table>

    @if (!string.IsNullOrEmpty(_msg) && !_modalOpen)
    {
        <p class="muted">@_msg</p>
    }
</div>

@if (_modalOpen)
{
    <div class="hd-modal-backdrop">
        <div class="hd-modal-scrim" @onclick="CloseModalAsync"></div>
        <div class="hd-modal" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrEmpty(_msg))
            {
                <p class="hd-modal-banner" role="alert">@_msg</p>
            }
            <h3 class="hd-modal-title">@(_editingId is null ? "Add application" : "Edit application")</h3>
            <div class="form-row"><label>Name</label><input class="hd-input" value="@_name" @oninput="OnNameInput" autocomplete="off" /></div>
            <div class="form-row"><label>Description</label><input class="hd-input" @bind="_desc" /></div>
            <div class="form-row"><label>Display order</label><input class="hd-input" type="number" @bind="_displayOrder" /></div>
            <label><input type="checkbox" @bind="_usesExt" /> Uses external database</label>
            <div class="form-row"><label>External connection name (config key)</label><input class="hd-input" @bind="_conn" /></div>
            <label><input type="checkbox" @bind="_active" /> Active</label>
            <div class="hd-modal-actions">
                <button type="button" class="hd-btn primary" @onclick="SaveAsync">Save</button>
                @if (_editingId is null)
                {
                    <button type="button" class="hd-btn" @onclick="ClearFormAsync">Clear</button>
                }
                <button type="button" class="hd-btn" @onclick="CloseModalAsync">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string TableId = "tbl-admin-applications";
    private const string InteropKey = "applications";

    private DotNetObjectReference<AdminApplications>? _interop;

    private int? _editingId;
    private bool _modalOpen;
    private string _name = "";
    private string? _desc;
    private int _displayOrder;
    private bool _usesExt;
    private string? _conn;
    private bool _active = true;
    private string? _msg;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        if (!await JS.InvokeAsync<bool>("helpdeskAdmin.needsInit", TableId))
            return;
        _interop = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("helpdeskAdmin.register", InteropKey, _interop);
        var url = Nav.ToAbsoluteUri("/api/grid/admin/applications").ToString();
        await JS.InvokeVoidAsync("helpdeskAdmin.initApplications", TableId, url);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("helpdeskAdmin.unregister", InteropKey);
            await JS.InvokeVoidAsync("helpdeskAdmin.destroyTable", TableId);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _interop?.Dispose();
    }

    private void ResetEmpty()
    {
        _editingId = null;
        _name = "";
        _desc = "";
        _displayOrder = 0;
        _usesExt = false;
        _conn = "";
        _active = true;
    }

    private void OpenAdd()
    {
        ResetEmpty();
        _modalOpen = true;
        _msg = null;
    }

    [JSInvokable]
    public async Task OpenEdit(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var a = await db.Applications.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (a is null)
        {
            _msg = "Application not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        _editingId = a.Id;
        _name = a.Name;
        _desc = a.Description;
        _displayOrder = a.DisplayOrder;
        _usesExt = a.UsesExternalDatabase;
        _conn = a.ExternalConnectionStringName;
        _active = a.IsActive;
        _modalOpen = true;
        _msg = null;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PromptDelete(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var a = await db.Applications.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (a is null)
        {
            _msg = "Not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete application \"{a.Name}\"? This removes the application and its links to pages and groups (catalog pages and groups are kept)."))
            return;

        var row = await db.Applications.FirstOrDefaultAsync(x => x.Id == id);
        if (row is null)
            return;

        db.Applications.Remove(row);
        if (!await db.TrySaveChangesAsync(JS))
            return;
        if (_editingId == id)
        {
            _modalOpen = false;
            ResetEmpty();
        }
        _msg = "Deleted.";
        StatusBar.SetMessage("Deleted.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModalAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Close the editor? Unsaved changes will be lost."))
            return;
        _modalOpen = false;
        ResetEmpty();
    }

    private async Task ClearFormAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear the form? Unsaved changes will be lost."))
            return;
        if (_editingId is { } eid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var a = await db.Applications.AsNoTracking().FirstOrDefaultAsync(x => x.Id == eid);
            if (a is not null)
                await OpenEdit(a.Id);
            else
                ResetEmpty();
        }
        else
        {
            ResetEmpty();
        }
    }

    private async Task SaveAsync()
    {
        var confirmMsg = _editingId is null
            ? "Create this application?"
            : "Save changes to this application?";
        if (!await JS.InvokeAsync<bool>("confirm", confirmMsg))
            return;

        var nameNorm = AdminNameValidation.RemoveWhitespace(_name);
        var nameErr = AdminNameValidation.ErrorIfEmptyCatalogName(nameNorm, "Name");
        if (nameErr is not null)
        {
            _msg = nameErr;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_conn))
        {
            var connErr = AdminNameValidation.ErrorIfHasSpaces(_conn, "External connection name");
            if (connErr is not null)
            {
                _msg = connErr;
                return;
            }
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (_editingId is { } eid)
        {
            var a = await db.Applications.FirstOrDefaultAsync(x => x.Id == eid);
            if (a is null) { _msg = "Not found."; return; }
            a.Name = nameNorm;
            a.Description = _desc;
            a.DisplayOrder = _displayOrder;
            a.UsesExternalDatabase = _usesExt;
            a.ExternalConnectionStringName = string.IsNullOrWhiteSpace(_conn) ? null : _conn.Trim();
            a.IsActive = _active;
            a.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            db.Applications.Add(new DeskApplication
            {
                Name = nameNorm,
                Description = _desc,
                DisplayOrder = _displayOrder,
                UsesExternalDatabase = _usesExt,
                ExternalConnectionStringName = string.IsNullOrWhiteSpace(_conn) ? null : _conn.Trim(),
                IsActive = _active,
                CreatedAt = DateTime.UtcNow
            });
        }

        if (!await db.TrySaveChangesAsync(JS))
            return;
        _modalOpen = false;
        ResetEmpty();
        _msg = "Saved.";
        StatusBar.SetMessage("Saved.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
    }

    private void OnNameInput(ChangeEventArgs e) =>
        _name = AdminNameValidation.RemoveWhitespace(e.Value?.ToString());
}
