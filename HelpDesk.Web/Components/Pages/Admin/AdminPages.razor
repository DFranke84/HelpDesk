@page "/admin/pages"

@attribute [Authorize(Roles = "Admin")]

@implements IAsyncDisposable

@using HelpDesk.Models

@using HelpDesk.Web.Validation

@using Microsoft.AspNetCore.Components

@inject IDbContextFactory<HelpDesk.Models.Data.HelpDeskDbContext> DbFactory

@inject IMenuRefreshNotifier MenuRefresh

@inject IStatusBarService StatusBar

@inject IJSRuntime JS

@inject NavigationManager Nav

<PageTitle>Pages</PageTitle>

<div class="hd-admin-page">
    <h1>Pages</h1>
    <div class="hd-admin-toolbar">
        <button type="button" class="hd-btn primary" @onclick="OpenAdd" disabled="@(_apps.Count == 0)">Add</button>
    </div>

    @if (_apps.Count == 0)
    {
        <div class="hd-card" style="margin-top:0.75rem;">
            <strong>No applications yet.</strong>
            <div class="muted">Add an application first (Administration → Applications). Pages require an application.</div>
        </div>
    }
    else
    {
        <table id="tbl-admin-pages" class="hd-dt cell-border compact stripe" style="width:100%"></table>
    }
    @if (!string.IsNullOrEmpty(_msg) && !_modalOpen)
    {
        <p class="muted">@_msg</p>
    }
</div>

@if (_modalOpen)
{
    <div class="hd-modal-backdrop">
        <div class="hd-modal-scrim" @onclick="CloseModalAsync"></div>
        <div class="hd-modal" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrEmpty(_msg))
            {
                <p class="hd-modal-banner" role="alert">@_msg</p>
            }
            <h3 class="hd-modal-title">@(_editingId is null ? "Add page" : "Edit page")</h3>
            <div class="form-row">
                <label>Application</label>
                <select class="hd-input" @bind="_appId">
                    @foreach (var a in _apps)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div class="form-row"><label>Name</label><input class="hd-input" value="@_name" @oninput="OnNameInput" autocomplete="off" /></div>
            
            <div class="form-row">
                <label>Page Type</label>
                <select class="hd-input" value="@_pageType" @onchange="OnPageTypeChanged">
                    <option value="@PageType.Page">Regular Page</option>
                    <option value="@PageType.GradientSeparator">Gradient Separator</option>
                    <option value="@PageType.ShadedSeparator">Shaded Separator</option>
                </select>
            </div>

            @if (_pageType == PageType.ShadedSeparator)
            {
                <div class="form-row">
                    <label>Separator Text</label>
                    <input class="hd-input" @bind="_separatorText" placeholder="Optional text for grouping" autocomplete="off" />
                    <div class="muted" style="font-size: 0.85em; margin-top: 0.25rem;">
                        Optional text to display in the separator for visual grouping
                    </div>
                </div>
            }
            
            @if (_pageType == PageType.Page)
            {
            <div class="form-row">
                <label>Navigation</label>
                <div style="margin-top: 0.5rem;">
                    <label style="display: block; margin-bottom: 0.5rem;">
                        <input type="radio" name="nav-type" value="route" checked="@(!string.IsNullOrWhiteSpace(_route))" @onchange="OnNavTypeChanged" />
                        Internal Route
                    </label>
                    <label style="display: block; margin-bottom: 0.5rem;">
                        <input type="radio" name="nav-type" value="url" checked="@(!string.IsNullOrWhiteSpace(_url))" @onchange="OnNavTypeChanged" />
                        External URL
                    </label>
                    <label style="display: block;">
                        <input type="radio" name="nav-type" value="none" checked="@(string.IsNullOrWhiteSpace(_route) && string.IsNullOrWhiteSpace(_url))" @onchange="OnNavTypeChanged" />
                        None (content in main window)
                    </label>
                </div>
            </div>
            
            @if (!string.IsNullOrWhiteSpace(_route))
            {
                <div class="form-row"><label>Route</label><input class="hd-input" @bind="_route" /></div>
            }
            
            @if (!string.IsNullOrWhiteSpace(_url))
            {
                <div class="form-row"><label>URL</label><input class="hd-input" @bind="_url" /></div>
                <label style="margin-top: 0.5rem;">
                    <input type="checkbox" @bind="_openInNewTab" /> 
                    Open in new tab
                    <div class="muted" style="margin-left: 1.5rem; font-size: 0.85em;">
                        Unchecked: URL content is embedded within the help desk interface<br/>
                        Checked: URL opens in a separate browser tab
                    </div>
                </label>
            }
            }
            
            <div class="form-row"><label>Display order</label><input class="hd-input" @bind="_order" /></div>
            <label><input type="checkbox" @bind="_active" /> Active</label>
            <div class="hd-modal-actions">
                <button type="button" class="hd-btn primary" @onclick="SaveAsync">Save</button>
                @if (_editingId is null)
                {
                    <button type="button" class="hd-btn" @onclick="ClearFormAsync">Clear</button>
                }
                <button type="button" class="hd-btn" @onclick="CloseModalAsync">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string TableId = "tbl-admin-pages";
    private const string InteropKey = "pages";

    private DotNetObjectReference<AdminPages>? _interop;
    private List<DeskApplication> _apps = new();
    private int? _editingId;
    private bool _modalOpen;
    private int _appId;
    private string _name = "";
    private string _route = "";
    private string _url = "";
    private bool _openInNewTab;
    private int _order;
    private bool _active = true;
    private PageType _pageType = PageType.Page;
    private string _separatorText = "";
    private string? _msg;

    protected override async Task OnInitializedAsync() => await ReloadAppsAsync();

    private async Task ReloadAppsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _apps = await db.Applications.AsNoTracking().OrderBy(a => a.Name).ToListAsync();
        if (_apps.Count > 0 && _appId == 0)
            _appId = _apps[0].Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_apps.Count == 0)
            return;
        if (!await JS.InvokeAsync<bool>("helpdeskAdmin.needsInit", TableId))
            return;
        if (_interop is null)
        {
            _interop = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("helpdeskAdmin.register", InteropKey, _interop);
        }
        var url = Nav.ToAbsoluteUri("/api/grid/admin/pages").ToString();
        await JS.InvokeVoidAsync("helpdeskAdmin.initPages", TableId, url);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("helpdeskAdmin.unregister", InteropKey);
            await JS.InvokeVoidAsync("helpdeskAdmin.destroyTable", TableId);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _interop?.Dispose();
    }

    private void ResetEmpty()
    {
        _editingId = null;
        _appId = _apps.Count > 0 ? _apps[0].Id : 0;
        _name = "";
        _route = "";
        _url = "";
        _openInNewTab = false;
        _order = 0;
        _active = true;
        _pageType = PageType.Page;
        _separatorText = "";
    }

    private void OpenAdd()
    {
        if (_apps.Count == 0)
        {
            _msg = "Add an application first.";
            return;
        }
        ResetEmpty();
        _modalOpen = true;
        _msg = null;
    }

    [JSInvokable]
    public async Task OpenEdit(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = await db.Pages.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (p is null)
        {
            _msg = "Page not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        _editingId = p.Id;
        _appId = p.DeskApplicationId;
        _name = p.Name;
        _route = p.Route ?? "";
        _url = p.Url ?? "";
        _openInNewTab = p.OpenInNewTab;
        _order = p.DisplayOrder;
        _active = p.IsActive;
        _pageType = p.PageType;
        _separatorText = p.SeparatorText ?? "";
        _modalOpen = true;
        _msg = null;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PromptDelete(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = await db.Pages.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (p is null)
        {
            _msg = "Not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete page \"{p.Name}\"? Application links are removed with the page."))
            return;

        var row = await db.Pages.FirstOrDefaultAsync(x => x.Id == id);
        if (row is null)
            return;

        db.Pages.Remove(row);
        if (!await db.TrySaveChangesAsync(JS))
            return;
        if (_editingId == id)
        {
            _modalOpen = false;
            ResetEmpty();
        }
        _msg = "Deleted.";
        StatusBar.SetMessage("Deleted.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModalAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Close the editor? Unsaved changes will be lost."))
            return;
        _modalOpen = false;
        ResetEmpty();
    }

    private async Task ClearFormAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear the form? Unsaved changes will be lost."))
            return;
        if (_editingId is { } pid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var p = await db.Pages.AsNoTracking().FirstOrDefaultAsync(x => x.Id == pid);
            if (p is not null)
                await OpenEdit(p.Id);
            else
                ResetEmpty();
        }
        else
        {
            ResetEmpty();
        }
    }

    private async Task SaveAsync()
    {
        var confirmMsg = _editingId is null ? "Create this page?" : "Save changes to this page?";
        if (!await JS.InvokeAsync<bool>("confirm", confirmMsg))
            return;

        var nameNorm = AdminNameValidation.RemoveWhitespace(_name);
        var nameErr = AdminNameValidation.ErrorIfEmptyCatalogName(nameNorm, "Name");
        if (nameErr is not null)
        {
            _msg = nameErr;
            return;
        }

        // Validate navigation fields
        var routeUrlErr = PageNavigationValidation.ErrorIfBothRouteAndUrl(_route, _url);
        if (routeUrlErr is not null)
        {
            _msg = routeUrlErr;
            return;
        }

        var newTabErr = PageNavigationValidation.ErrorIfNewTabWithoutUrl(_url, _openInNewTab);
        if (newTabErr is not null)
        {
            _msg = newTabErr;
            return;
        }

        var urlErr = PageNavigationValidation.ErrorIfInvalidUrl(_url);
        if (urlErr is not null)
        {
            _msg = urlErr;
            return;
        }

        var routeErr = AdminNameValidation.ErrorIfHasSpaces(_route, "Route");
        if (routeErr is not null)
        {
            _msg = routeErr;
            return;
        }

        // Validate separator-specific rules
        var separatorNavErr = PageNavigationValidation.ErrorIfSeparatorHasNavigation(_pageType, _route, _url);
        if (separatorNavErr is not null)
        {
            _msg = separatorNavErr;
            return;
        }

        var separatorTextErr = PageNavigationValidation.ErrorIfSeparatorTextOnWrongType(_pageType, _separatorText);
        if (separatorTextErr is not null)
        {
            _msg = separatorTextErr;
            return;
        }

        var separatorNewTabErr = PageNavigationValidation.ErrorIfSeparatorWithNewTab(_pageType, _openInNewTab);
        if (separatorNewTabErr is not null)
        {
            _msg = separatorNewTabErr;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (_editingId is { } pid)
        {
            var p = await db.Pages.FirstOrDefaultAsync(x => x.Id == pid);
            if (p is null)
            {
                _msg = "Not found.";
                return;
            }

            if (_appId == 0) { _msg = "Select an application."; return; }
            p.DeskApplicationId = _appId;
            p.Name = nameNorm;
            p.Route = string.IsNullOrWhiteSpace(_route) ? null : _route.Trim();
            p.Url = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim();
            p.OpenInNewTab = _openInNewTab;
            p.DisplayOrder = _order;
            p.IsActive = _active;
            p.PageType = _pageType;
            p.SeparatorText = string.IsNullOrWhiteSpace(_separatorText) ? null : _separatorText.Trim();
            p.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            if (_appId == 0) { _msg = "Select an application."; return; }
            db.Pages.Add(new DeskPage
            {
                DeskApplicationId = _appId,
                Name = nameNorm,
                Route = string.IsNullOrWhiteSpace(_route) ? null : _route.Trim(),
                Url = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim(),
                OpenInNewTab = _openInNewTab,
                DisplayOrder = _order,
                IsActive = _active,
                PageType = _pageType,
                SeparatorText = string.IsNullOrWhiteSpace(_separatorText) ? null : _separatorText.Trim(),
                CreatedAt = DateTime.UtcNow
            });
        }

        if (!await db.TrySaveChangesAsync(JS))
            return;
        _modalOpen = false;
        ResetEmpty();
        await ReloadAppsAsync();
        _msg = "Saved.";
        StatusBar.SetMessage("Saved.");
        MenuRefresh.NotifyMenuChanged();
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
    }

    private void OnNameInput(ChangeEventArgs e) =>
        _name = AdminNameValidation.RemoveWhitespace(e.Value?.ToString());

    private void OnPageTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<PageType>(e.Value?.ToString(), out var pageType))
        {
            _pageType = pageType;
            
            // Clear navigation fields for separators
            if (_pageType != PageType.Page)
            {
                _route = "";
                _url = "";
                _openInNewTab = false;
            }
            
            // Clear separator text for non-shaded separators
            if (_pageType != PageType.ShadedSeparator)
            {
                _separatorText = "";
            }
        }
    }

    private void OnNavTypeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        switch (value)
        {
            case "route":
                _url = "";
                _openInNewTab = false;
                if (string.IsNullOrWhiteSpace(_route))
                    _route = "/";
                break;
            case "url":
                _route = "";
                if (string.IsNullOrWhiteSpace(_url))
                    _url = "https://";
                break;
            case "none":
                _route = "";
                _url = "";
                _openInNewTab = false;
                break;
        }
    }
}
