@using HelpDesk.Web.Services
@implements IDisposable
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await EnforceAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () => await EnforceAsync());

    private async Task EnforceAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        if (user.Identity?.IsAuthenticated != true)
            return;
        if (!user.HasClaim(AuthClaims.MustChangePassword, "true"))
            return;

        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath;
        if (path.StartsWith("/account/first-login-password", StringComparison.OrdinalIgnoreCase))
            return;

        var returnUrl = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
        Nav.NavigateTo($"/account/first-login-password?returnUrl={returnUrl}", forceLoad: true);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
