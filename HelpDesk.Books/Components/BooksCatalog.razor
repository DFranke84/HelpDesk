@page "/user/books/books"

@attribute [Authorize]

@implements IAsyncDisposable

@using Microsoft.EntityFrameworkCore
@using HelpDesk.Books.Models.Data
@using HelpDesk.Books.Services

@inject IDbContextFactory<BooksDbContext> DbFactory
@inject IBooksAccess Access
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Books</PageTitle>

@if (_loading)
{
    <div class="hd-admin-page">
        <h1>Books</h1>
        <p class="muted">Loading...</p>
    </div>
}
else if (_accessDenied)
{
    <div class="hd-admin-page">
        <h1>Access Denied</h1>
        <div class="alert alert-warning">
            <h4>Read Permission Required</h4>
            <p>You do not have permission to access the Books catalog. Please contact your administrator for access.</p>
        </div>
    </div>
}
else
{
    <div class="hd-admin-page">
        <h1>Books</h1>
        <p class="muted">Titles in the <strong>Books</strong> database (<code>dbo.Books</code>).</p>
        <div class="hd-admin-toolbar">
            <button type="button" class="hd-btn primary @(!_canCreate ? "hd-permission-disabled" : "")" 
                    @onclick="OpenAdd" 
                    disabled="@(_publishers.Count == 0 || !_canCreate)"
                    title="@(!_canCreate ? "You don't have permission to create books" : "")">Add</button>
        </div>
        @if (_publishers.Count == 0)
        {
            <div class="hd-card" style="margin-top:0.75rem;">
                <strong>No publishers.</strong>
                <div class="muted">Run database setup scripts so <code>Publishers</code> and <code>Books</code> exist.</div>
            </div>
        }
        else
        {
            <table id="tbl-books-catalog" class="hd-dt cell-border compact stripe" style="width:100%"></table>
        }
        @if (!string.IsNullOrEmpty(_msg) && !_modalOpen)
        {
            <p class="muted">@_msg</p>
        }
    </div>
}

@if (_modalOpen)
{
    <div class="hd-modal-backdrop">
        <div class="hd-modal-scrim" @onclick="CloseModalAsync"></div>
        <div class="hd-modal" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrEmpty(_msg))
            {
                <p class="hd-modal-banner" role="alert">@_msg</p>
            }
            <h3 class="hd-modal-title">@(_editingId is null ? "Add book" : "Edit book")</h3>
            <div class="form-row">
                <label>ISBN-13 (13 chars)</label>
                <input class="hd-input" value="@_isbn13" @oninput="OnIsbnInput" maxlength="13" autocomplete="off" />
            </div>
            <div class="form-row">
                <label>Title</label>
                <input class="hd-input" @bind="_title" />
            </div>
            <div class="form-row">
                <label>Subtitle</label>
                <input class="hd-input" @bind="_subtitle" />
            </div>
            <div class="form-row">
                <label>Publication year</label>
                <input class="hd-input" type="number" @bind="_year" />
            </div>
            <div class="form-row">
                <label>Publisher</label>
                <select class="hd-input" @bind="_publisherId">
                    @foreach (var p in _publishers)
                    {
                        <option value="@p.PublisherId">@p.Name</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label>Pages</label>
                <input class="hd-input" type="number" @bind="_pages" />
            </div>
            <div class="form-row">
                <label>Language (2 letters)</label>
                <input class="hd-input" value="@_languageCode" @oninput="OnLangInput" maxlength="2" autocomplete="off" />
            </div>
            <div class="form-row">
                <label>Description</label>
                <textarea class="hd-input" rows="3" @bind="_description"></textarea>
            </div>
            <div class="hd-modal-actions">
                <button type="button" class="hd-btn primary" @onclick="SaveAsync">Save</button>
                @if (_editingId is null)
                {
                    <button type="button" class="hd-btn" @onclick="ClearFormAsync">Clear</button>
                }
                <button type="button" class="hd-btn" @onclick="CloseModalAsync">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string TableId = "tbl-books-catalog";
    private const string InteropKey = "booksCatalog";

    // Permission tracking
    private bool _canRead = false;
    private bool _canCreate = false;
    private bool _canUpdate = false; 
    private bool _canDelete = false;
    private bool _loading = true;
    private bool _accessDenied = false;

    private DotNetObjectReference<BooksCatalog>? _interop;
    private List<Publisher> _publishers = new();
    private int? _editingId;
    private bool _modalOpen;
    private string _isbn13 = "";
    private string _title = "";
    private string? _subtitle;
    private int _year = DateTime.UtcNow.Year;
    private int _publisherId;
    private int? _pages;
    private string _languageCode = "en";
    private string? _description;
    private string? _msg;
    

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load permissions first
            await LoadUserPermissionsAsync();
            // Check if user has read permission
            if (!_canRead)
            {
                _accessDenied = true;
                _loading = false;
                return;
            }
            
            // Load Books database publishers only if user has read access
            await using var booksDb = await DbFactory.CreateDbContextAsync();
            _publishers = await booksDb.Publishers.AsNoTracking().OrderBy(p => p.Name).ToListAsync();
            if (_publishers.Count > 0)
                _publisherId = _publishers[0].PublisherId;
        }
        catch (Exception)
        {
            _accessDenied = true;
        }
        finally
        {
            _loading = false;
        }
    }
    
    /// <summary>
    /// Re-read the user's Books permissions from the central rules. Called on page load and again
    /// before every change, because the grid buttons can be bypassed by calling the server methods directly.
    /// </summary>
    private async Task LoadUserPermissionsAsync()
    {
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var p = await Access.GetPermissionsAsync(state.User);
            _canRead = p.CanRead;
            _canCreate = p.CanCreate;
            _canUpdate = p.CanUpdate;
            _canDelete = p.CanDelete;
        }
        catch (Exception)
        {
            // On error, default to no permissions for security
            _canRead = _canCreate = _canUpdate = _canDelete = false;
        }
    }

    /// <summary>True when the user may perform the action right now; otherwise shows a message and returns false.</summary>
    private async Task<bool> EnsureAllowedAsync(Func<bool> allowed, string action)
    {
        await LoadUserPermissionsAsync();
        if (_canRead && allowed())
            return true;

        _modalOpen = false;
        _msg = $"You don't have permission to {action} books.";
        await InvokeAsync(StateHasChanged);
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only initialize JavaScript if user has read permission and page isn't loading
        if (_loading || _accessDenied || !_canRead)
        {
            return;
        }
            
        if (firstRender)
        {
            try
            {
                // Load the Books JavaScript directly with a simple script injection
                await JS.InvokeVoidAsync("eval", @"
                    (function() {
                        // Remove any existing script first
                        var existingScript = document.querySelector('script[src=""/books-assets/js/booksCatalogGrids.js""]');
                        if (existingScript) {
                            existingScript.remove();
                        }
                        
                        // Add the script
                        var script = document.createElement('script');
                        script.src = '/books-assets/js/booksCatalogGrids.js';
                        script.async = false; // Load synchronously relative to other scripts
                        document.head.appendChild(script);
                    })()
                ");
                
                // Give the script time to load
                await Task.Delay(1000);
            }
            catch (Exception)
            {
                // Script loading failed, continue without JavaScript enhancement
            }
        }
        
        if (_publishers.Count == 0)
        {
            return;
        }
            
        // Check dependencies
        var adminAvailable = await JS.InvokeAsync<bool>("eval", "!!(window.helpdeskAdmin && window.helpdeskAdmin.needsInit)");
        if (!adminAvailable)
        {
            return;
        }
            
        var needsInit = await JS.InvokeAsync<bool>("helpdeskAdmin.needsInit", TableId);
        if (!needsInit)
        {
            return;
        }
            
        if (_interop is null)
        {
            _interop = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("helpdeskAdmin.register", InteropKey, _interop);
        }

        var url = Nav.ToAbsoluteUri("/api/grid/books/catalog").ToString();
        
        // Check if the Books catalog function is available
        var initFunctionExists = await JS.InvokeAsync<bool>("eval", "!!(window.helpdeskAdmin && window.helpdeskAdmin.initBooksCatalog)");
        
        // Try to load the script one more time if the function doesn't exist
        if (!initFunctionExists)
        {
            try 
            {
                await JS.InvokeVoidAsync("eval", @"
                    fetch('/books-assets/js/booksCatalogGrids.js')
                        .then(response => {
                            console.log('Script fetch response:', response.status, response.statusText);
                            return response.text();
                        })
                        .then(scriptContent => {
                            console.log('Script content length:', scriptContent.length);
                            if (scriptContent.includes('initBooksCatalog')) {
                                console.log('initBooksCatalog found in script content');
                                // Execute the script content directly
                                eval(scriptContent);
                                console.log('Script executed directly');
                            } else {
                                console.log('initBooksCatalog NOT found in script content');
                            }
                        })
                        .catch(err => console.error('Script fetch failed:', err));
                ");
                
                await Task.Delay(500);
                initFunctionExists = await JS.InvokeAsync<bool>("eval", "!!(window.helpdeskAdmin && window.helpdeskAdmin.initBooksCatalog)");
            }
            catch (Exception)
            {
                // Script loading failed, continue without enhanced functionality
            }
        }
        
        if (initFunctionExists)
        {
            try
            {
                await JS.InvokeVoidAsync("helpdeskAdmin.initBooksCatalog", TableId, url, new { 
                    canCreate = _canCreate, 
                    canRead = _canRead,
                    canUpdate = _canUpdate, 
                    canDelete = _canDelete 
                });
            }
            catch (Exception)
            {
                // Grid initialization failed, table will remain as basic HTML
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("helpdeskAdmin.unregister", InteropKey);
            await JS.InvokeVoidAsync("helpdeskAdmin.destroyTable", TableId);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _interop?.Dispose();
    }

    private void ResetEmpty()
    {
        _editingId = null;
        _isbn13 = "";
        _title = "";
        _subtitle = "";
        _year = DateTime.UtcNow.Year;
        if (_publishers.Count > 0)
            _publisherId = _publishers[0].PublisherId;
        _pages = null;
        _languageCode = "en";
        _description = "";
    }

    private async Task OpenAdd()
    {
        if (!await EnsureAllowedAsync(() => _canCreate, "create"))
            return;

        ResetEmpty();
        _modalOpen = true;
        _msg = null;
    }

    [JSInvokable]
    public async Task OpenEdit(int id)
    {
        if (!await EnsureAllowedAsync(() => _canUpdate, "edit"))
            return;

        await using var db= await DbFactory.CreateDbContextAsync();
        var b = await db.Books.AsNoTracking().FirstOrDefaultAsync(x => x.BookId == id);
        if (b is null)
        {
            _msg = "Book not found.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _editingId = b.BookId;
        _isbn13 = b.Isbn13.Trim();
        _title = b.Title;
        _subtitle = b.Subtitle;
        _year = b.PublicationYear;
        _publisherId = b.PublisherId;
        _pages = b.Pages;
        _languageCode = string.IsNullOrWhiteSpace(b.LanguageCode) ? "en" : b.LanguageCode.Trim();
        _description = b.Description;
        _modalOpen = true;
        _msg = null;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PromptDelete(int id)
    {
        if (!await EnsureAllowedAsync(() => _canDelete, "delete"))
            return;

        _msg = null;
        string? titleToConfirm;
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var b = await db.Books.AsNoTracking().FirstOrDefaultAsync(x => x.BookId == id);
            if (b is null)
            {
                _msg = "Not found.";
                await InvokeAsync(StateHasChanged);
                return;
            }
            titleToConfirm = b.Title;
        }

        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{titleToConfirm}\"?"))
            return;

        // Permission may have been removed while the prompt was open.
        if (!await EnsureAllowedAsync(() => _canDelete, "delete"))
            return;

        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Books.FirstOrDefaultAsync(x => x.BookId == id);
            if (row is null)
                return;

            db.Books.Remove(row);
            await db.SaveChangesAsync();
        }
        if (_editingId == id)
        {
            _modalOpen = false;
            ResetEmpty();
        }

        _msg = "Deleted.";
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseModalAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Close the editor? Unsaved changes will be lost."))
            return;
        _modalOpen = false;
        ResetEmpty();
    }

    private async Task ClearFormAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Clear the form? Unsaved changes will be lost."))
            return;
        if (_editingId is { } bid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var b = await db.Books.AsNoTracking().FirstOrDefaultAsync(x => x.BookId == bid);
            if (b is not null)
                await OpenEdit(b.BookId);
            else
                ResetEmpty();
        }
        else
        {
            ResetEmpty();
        }
    }

    private async Task SaveAsync()
    {
        _msg = null;
        
        var isbn = NormalizeIsbn13(_isbn13);
        if (isbn.Length != 13)
        {
            _msg = "ISBN-13 must be exactly 13 characters.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_title))
        {
            _msg = "Title is required.";
            return;
        }

        if (!_publishers.Any(p => p.PublisherId == _publisherId))
        {
            _msg = "Pick a valid publisher.";
            return;
        }

        var lang = NormalizeLang(_languageCode);
        if (lang.Length != 2)
        {
            _msg = "Language must be 2 letters (e.g. en).";
            return;
        }

        var year = (short)Math.Clamp(_year, 1, 3000);

        var editingId = _editingId;
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existingIsbns = await db.Books.AsNoTracking()
                .Where(x => !editingId.HasValue || x.BookId != editingId.Value)
                .Select(x => x.Isbn13)
                .ToListAsync();
            if (existingIsbns.Any(s => string.Equals(s.Trim(), isbn, StringComparison.Ordinal)))
            {
                _msg = "Another book already uses this ISBN-13.";
                return;
            }
        }

        var confirmMsg = _editingId is null ? "Create this book?" : "Save changes?";
        if (!await JS.InvokeAsync<bool>("confirm", confirmMsg))
            return;

        // Checked on the server immediately before writing: hiding buttons in the browser is not protection.
        var creating = _editingId is null;
        if (!await EnsureAllowedAsync(() => creating ? _canCreate : _canUpdate, creating ? "create" : "edit"))
            return;

        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_editingId is { } id)
            {
                var b = await db.Books.FirstOrDefaultAsync(x => x.BookId == id);
                if (b is null)
                {
                    _msg = "Not found.";
                    return;
                }

                b.Isbn13 = isbn;
                b.Title = _title.Trim();
                b.Subtitle = string.IsNullOrWhiteSpace(_subtitle) ? null : _subtitle.Trim();
                b.PublicationYear = year;
                b.PublisherId = _publisherId;
                b.Pages = _pages;
                b.LanguageCode = lang;
                b.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
            }
            else
            {
                db.Books.Add(new Book
                {
                    Isbn13 = isbn,
                    Title = _title.Trim(),
                    Subtitle = string.IsNullOrWhiteSpace(_subtitle) ? null : _subtitle.Trim(),
                    PublicationYear = year,
                    PublisherId = _publisherId,
                    Pages = _pages,
                    LanguageCode = lang,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    CreatedAt = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
        }
        _modalOpen = false;
        ResetEmpty();
        _msg = "Saved.";
        await JS.InvokeVoidAsync("helpdeskAdmin.reloadTable", TableId);
    }

    private static string NormalizeIsbn13(string? s)
    {
        if (string.IsNullOrEmpty(s))
            return "";
        var sb = new System.Text.StringBuilder(13);
        foreach (var c in s)
        {
            if (char.IsDigit(c) && sb.Length < 13)
                sb.Append(c);
        }
        return sb.ToString();
    }

    private static string NormalizeLang(string? s)
    {
        if (string.IsNullOrWhiteSpace(s))
            return "";
        var two = s.Trim();
        if (two.Length >= 2)
            two = two[..2];
        return two.ToUpperInvariant();
    }

    private void OnIsbnInput(ChangeEventArgs e) =>
        _isbn13 = NormalizeIsbn13(e.Value?.ToString());

    private void OnLangInput(ChangeEventArgs e) =>
        _languageCode = NormalizeLang(e.Value?.ToString());
}
